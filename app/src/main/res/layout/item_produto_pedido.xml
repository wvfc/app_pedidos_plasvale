<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="#F7F9FB"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textoDescricao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/azul_plasvale"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textoDetalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_fraco"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textoAlerta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/laranja"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/botaoEditar"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:text="Editar"
            android:textColor="@color/azul_plasvale"
            android:textSize="12sp" />

        <Button
            android:id="@+id/botaoRemover"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:text="Remover"
            android:textColor="@color/vermelho"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
